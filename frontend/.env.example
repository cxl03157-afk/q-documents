# このファイルを .env.local にコピーして使う（.env.local はコミットされない）。
#
#   cp .env.example .env.local
#
# ローカル開発（npm run dev）でのみ必要。デプロイ時は scripts/deploy-frontend.sh が
# Terraform の出力から VITE_API_BASE_URL を渡すので、値を控えておく必要はない。

# --- 画面が叩く先 -----------------------------------------------------------
#
# ローカルでは相対パスにする。Vite の dev サーバーが /api を下の TARGET へ中継し、
# ブラウザから見れば同一オリジンになるので CORS が発生しない。
#
# 直接 execute-api の URL を入れると CORS で必ず弾かれる。
# Lambda の ALLOWED_ORIGIN は CloudFront のドメイン1つだけで、localhost を
# 足すと本番の Lambda が localhost からの呼び出しを恒久的に受け付けることになるため
# （CLAUDE.md §8「CORS は自サイトのオリジンのみ許可し、ワイルドカードは使用しない」）。
VITE_API_BASE_URL=/api

# --- dev サーバーの中継先 ----------------------------------------------------
#
# 値は Terraform の出力から取る:
#
#   terraform -chdir=../infra output -raw api_invoke_url
#
# ビルドには埋め込まれない（vite.config.ts が dev サーバーの設定にだけ使う）。
VITE_API_PROXY_TARGET=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod
