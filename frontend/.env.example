# このファイルを .env.local にコピーして使う（.env.local はコミットされない）。
#
#   cp .env.example .env.local
#
# 値は Terraform の出力から取れる:
#
#   terraform -chdir=../infra output -raw api_invoke_url
#
# デプロイ時は scripts/deploy-frontend.sh が同じ出力から自動で渡すため、
# このファイルはローカル開発（npm run dev）でのみ必要。
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod
