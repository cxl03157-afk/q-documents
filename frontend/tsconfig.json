{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../shared", "vite.config.ts"],
  // shared/*.test.ts のみ除外する。frontend/node_modules から見て親を跨ぐため vitest の型解決が
  // できない（応急対応。詳細は docs/context.md の未解決事項を参照。backend着手時にnpm workspaces化で
  // 根本対応する）。src/ にはこの問題がないので対象外にしない。
  // テストの正しさは Vitest の実行（アサーションの成否）で担保する。
  "exclude": ["../shared/**/*.test.ts"]
}
