{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // shared/*.test.ts の除外は npm workspaces 化で不要になった。
  // node_modules がリポジトリルートに1つになり、shared/ からも vitest の型が解決できる
  // （Node のモジュール解決は見つかるまで親方向に node_modules を遡るため）。
  "include": ["src", "../shared", "vite.config.ts"]
}
