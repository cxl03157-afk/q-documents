# 依存
node_modules/

# ビルド成果物
dist/
*.zip

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
# 保存済みプラン。バイナリで、作った時点の state に紐づくため共有しても意味がない
tfplan
*.tfplan
# .terraform.lock.hcl は除外しない。プロバイダのバージョン固定はコミットして共有する

# 環境変数
.env
.env.*
!.env.example

# OS・ログ
.DS_Store
*.log

# 個人設定
.claude/settings.local.json
