# このファイルをコピーして terraform.tfvars を作る。
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars は .gitignore 済み（*.tfvars）。実値をコミットしない。

# 画面・API へのアクセスを許可するグローバルIP（CIDR）。
# 単一IPなら "x.x.x.x/32"。社内で運用するときは社内のレンジに差し替える。
# 自分のグローバルIPは `curl -s https://checkip.amazonaws.com` で確認できる。
allowed_cidrs = ["203.0.113.0/24"]

# AWS Budgets のアラート送り先
budget_notification_email = "you@example.com"

# 月額の上限（USD）。要件の「月1,000円以内」を 1USD=145円 で換算した既定値は 7。
# 変更する場合のみ記入する
# monthly_budget_usd = 7
